{
  "version": 2,
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "functions": {
    "api/*.js": {
      "includeFiles": "carriers/apicarrier.all.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/track",
      "destination": "/api/track.js"
    },
    {
      "source": "/api/carriers",
      "destination": "/api/carriers.js"
    },
    {
      "source": "/api/parcel-updates",
      "destination": "/api/parcel-updates.js"
    },
    {
      "source": "/api/news",
      "destination": "/api/news.js"
    },
    {
      "source": "/api/news-post",
      "destination": "/api/news-post.js"
    }
  ],
  "installCommand": "npm install"
}
