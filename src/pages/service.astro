---
import { Image } from "astro:assets";
import photo0 from "../assets/legacy/img/service-1.jpg";
import photo1 from "../assets/legacy/img/service-2.jpg";
import photo2 from "../assets/legacy/img/service-3.jpg";
import photo3 from "../assets/legacy/img/service-4.jpg";
import photo4 from "../assets/legacy/img/service-5.jpg";
import photo5 from "../assets/legacy/img/service-6.jpg";
import photo6 from "../assets/legacy/img/testimonial-1.jpg";
import photo7 from "../assets/legacy/img/testimonial-2.jpg";
import photo8 from "../assets/legacy/img/testimonial-3.jpg";
import photo9 from "../assets/legacy/img/testimonial-4.jpg";
import LegacyScripts from '../components/LegacyScripts.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="HL Trung Việt Logistics - Dịch vụ" bodyClass="" standardHead={true}>

    <!-- Spinner Start -->
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
    <!-- Spinner End -->


    <!-- Navbar Start -->
    <Navbar />
    <!-- Navbar End -->


    <!-- Page Header Start -->
    <div class="container-fluid page-header py-5" style="margin-bottom: 6rem;">
        <div class="container py-5">
            <h1 class="display-3 text-white mb-3 animated slideInDown">Dịch vụ</h1>
            <nav aria-label="breadcrumb animated slideInDown">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a class="text-white" href="#">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a class="text-white" href="#">Trang</a></li>
                    <li class="breadcrumb-item text-white active" aria-current="page">Dịch vụ</li>
                </ol>
            </nav>
        </div>
    </div>
    <!-- Page Header End -->


    <!-- Service Start -->
    <div class="container-xxl py-5">
        <div class="container py-5">
            <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
                <h6 class="text-secondary text-uppercase">Dịch vụ</h6>
                <h1 class="mb-5">Giải pháp vận chuyển Trung – Việt</h1>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4 wow fadeInUp" data-wow-delay="0.3s">
                    <div class="service-item p-4">
                        <div class="overflow-hidden mb-4">
                            <Image class="img-fluid" src={photo0} alt="" />
                        </div>
                        <h4 class="mb-3">Vận chuyển hàng hóa</h4>
                        <p>Đường bộ, đường biển, đường hàng không từ Trung Quốc về Việt Nam, tối ưu chi phí và tốc độ.</p>
                        <a class="btn-slide mt-2" href=""><i class="fa fa-arrow-right"></i><span>Xem thêm</span></a>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 wow fadeInUp" data-wow-delay="0.5s">
                    <div class="service-item p-4">
                        <div class="overflow-hidden mb-4">
                            <Image class="img-fluid" src={photo1} alt="" />
                        </div>
                        <h4 class="mb-3">Thông quan 2 đầu</h4>
                        <p>Trực tiếp báo quan, xử lý kiểm hóa, đảm bảo thông quan trơn tru giữa Trung – Việt.</p>
                        <a class="btn-slide mt-2" href=""><i class="fa fa-arrow-right"></i><span>Xem thêm</span></a>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 wow fadeInUp" data-wow-delay="0.7s">
                    <div class="service-item p-4">
                        <div class="overflow-hidden mb-4">
                            <Image class="img-fluid" src={photo2} alt="" />
                        </div>
                        <h4 class="mb-3">Đánh nguyên cont</h4>
                        <p>Hỗ trợ tổng kho lớn, gom/đánh cont trực tiếp từ xưởng về Việt Nam, giảm chi phí logistics.</p>
                        <a class="btn-slide mt-2" href=""><i class="fa fa-arrow-right"></i><span>Xem thêm</span></a>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 wow fadeInUp" data-wow-delay="0.3s">
                    <div class="service-item p-4">
                        <div class="overflow-hidden mb-4">
                            <Image class="img-fluid" src={photo3} alt="" />
                        </div>
                        <h4 class="mb-3">Kho bãi chính chủ</h4>
                        <p>Kho Bằng Tường, Quảng Châu chính chủ, không trung gian; xử lý nhanh, an toàn.</p>
                        <a class="btn-slide mt-2" href=""><i class="fa fa-arrow-right"></i><span>Xem thêm</span></a>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 wow fadeInUp" data-wow-delay="0.5s">
                    <div class="service-item p-4">
                        <div class="overflow-hidden mb-4">
                            <Image class="img-fluid" src={photo4} alt="" />
                        </div>
                        <h4 class="mb-3">Kiểm hàng & đóng gói</h4>
                        <p>Kiểm hàng tại kho Trung Quốc, đóng gói tối ưu, hạn chế hư hỏng và chi phí vận chuyển.</p>
                        <a class="btn-slide mt-2" href=""><i class="fa fa-arrow-right"></i><span>Xem thêm</span></a>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 wow fadeInUp" data-wow-delay="0.7s">
                    <div class="service-item p-4">
                        <div class="overflow-hidden mb-4">
                            <Image class="img-fluid" src={photo5} alt="" />
                        </div>
                        <h4 class="mb-3">Tư vấn cước & lộ trình</h4>
                        <p>Gợi ý phương án tối ưu thời gian, chi phí cho từng loại hàng, hỗ trợ 24/7.</p>
                        <a class="btn-slide mt-2" href=""><i class="fa fa-arrow-right"></i><span>Xem thêm</span></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Service End -->


    <!-- Testimonial Start -->
    <div class="container-xxl py-5 wow fadeInUp" data-wow-delay="0.1s">
        <div class="container py-5">
            <div class="text-center">
                <h6 class="text-secondary text-uppercase">Cảm nhận</h6>
                <h1 class="mb-0">Khách hàng nói gì?</h1>
            </div>
            <div class="owl-carousel testimonial-carousel wow fadeInUp" data-wow-delay="0.1s">
                <div class="testimonial-item p-4 my-5">
                    <i class="fa fa-quote-right fa-3x text-light position-absolute top-0 end-0 mt-n3 me-4"></i>
                    <div class="d-flex align-items-end mb-4">
                        <Image class="img-fluid flex-shrink-0" src={photo6} style="width: 80px; height: 80px;" alt="" />
                        <div class="ms-4">
                            <h5 class="mb-1">Khách hàng</h5>
                            <p class="m-0">Ecommerce</p>
                        </div>
                    </div>
                    <p class="mb-0">HL Trung Việt Logistics là đối tác vận chuyển tin cậy cho các lô hàng thương mại điện tử của chúng tôi.</p>
                </div>
                <div class="testimonial-item p-4 my-5">
                    <i class="fa fa-quote-right fa-3x text-light position-absolute top-0 end-0 mt-n3 me-4"></i>
                    <div class="d-flex align-items-end mb-4">
                        <Image class="img-fluid flex-shrink-0" src={photo7} style="width: 80px; height: 80px;" alt="" />
                        <div class="ms-4">
                            <h5 class="mb-1">Khách hàng</h5>
                            <p class="m-0">Doanh nghiệp</p>
                        </div>
                    </div>
                    <p class="mb-0">Hàng hóa luôn được giao đúng hẹn, đóng gói cẩn thận và được cập nhật trạng thái liên tục.</p>
                </div>
                <div class="testimonial-item p-4 my-5">
                    <i class="fa fa-quote-right fa-3x text-light position-absolute top-0 end-0 mt-n3 me-4"></i>
                    <div class="d-flex align-items-end mb-4">
                        <Image class="img-fluid flex-shrink-0" src={photo8} style="width: 80px; height: 80px;" alt="" />
                        <div class="ms-4">
                            <h5 class="mb-1">Khách hàng</h5>
                            <p class="m-0">Bán lẻ</p>
                        </div>
                    </div>
                    <p class="mb-0">Kiểm hàng, đóng gói tốt, chi phí hợp lý giúp chúng tôi yên tâm nhập hàng.</p>
                </div>
                <div class="testimonial-item p-4 my-5">
                    <i class="fa fa-quote-right fa-3x text-light position-absolute top-0 end-0 mt-n3 me-4"></i>
                    <div class="d-flex align-items-end mb-4">
                        <Image class="img-fluid flex-shrink-0" src={photo9} style="width: 80px; height: 80px;" alt="" />
                        <div class="ms-4">
                            <h5 class="mb-1">Khách hàng</h5>
                            <p class="m-0">Nhập khẩu</p>
                        </div>
                    </div>
                    <p class="mb-0">Tư vấn cước tận tâm, hỗ trợ thông quan các ca khó rất hiệu quả.</p>
                </div>
            </div>
        </div>
    </div>
    <!-- Testimonial End -->


    <Footer />


    <!-- Back to Top -->
    <a href="#" class="btn btn-lg btn-primary btn-lg-square rounded-0 back-to-top"><i class="bi bi-arrow-up"></i></a>


    <!-- JavaScript Libraries -->
    <LegacyScripts />

    <!-- Template Javascript -->
    <script is:inline src="/js/navigation.js"></script>
    <script is:inline src="js/main.js"></script>

</BaseLayout>
