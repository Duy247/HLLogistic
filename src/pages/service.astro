---
import { Image } from "astro:assets";
import photo0 from "../assets/legacy/img/service-1.jpg";
import photo1 from "../assets/legacy/img/service-2.jpg";
import photo2 from "../assets/legacy/img/service-3.jpg";
import photo3 from "../assets/legacy/img/service-4.jpg";
import photo4 from "../assets/legacy/img/service-5.jpg";
import photo5 from "../assets/legacy/img/service-6.jpg";
import photo6 from "../assets/legacy/img/testimonial-1.jpg";
import photo7 from "../assets/legacy/img/testimonial-2.jpg";
import photo8 from "../assets/legacy/img/testimonial-3.jpg";
import photo9 from "../assets/legacy/img/testimonial-4.jpg";
import Layout from "../layouts/V2Layout.astro";
---
<Layout title="Dịch vụ · HL Trung Việt Logistics">
  <section class="tint">
    <div class="wrap section page-intro">
      <p class="eyebrow">HL TRUNG VIỆT LOGISTICS / SERVICES</p>
      <h1 data-en="Services">Dịch vụ</h1>
      <a class="text-link" href="index.html" data-en="Home ↗">Trang chủ ↗</a>
    </div>
  </section>
  <section class="wrap section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Dịch vụ</p>
        <h2>Giải pháp vận chuyển Trung – Việt</h2>
      </div>
    </div>
    <div class="grid three">
      <article class="card service-detail">
        <Image src={photo0} alt="" loading="lazy" />
        <span class="number">01</span>
        <h3>Vận chuyển hàng hóa</h3>
        <p>Đường bộ, đường biển, đường hàng không từ Trung Quốc về Việt Nam, tối ưu chi phí và tốc độ.</p>
        <a class="text-link" href="contact.html" data-en="Get advice ↗">Nhận tư vấn ↗</a>
      </article>
      <article class="card service-detail">
        <Image src={photo1} alt="" loading="lazy" />
        <span class="number">02</span>
        <h3>Thông quan 2 đầu</h3>
        <p>Trực tiếp báo quan, xử lý kiểm hóa, đảm bảo thông quan trơn tru giữa Trung – Việt.</p>
        <a class="text-link" href="contact.html" data-en="Get advice ↗">Nhận tư vấn ↗</a>
      </article>
      <article class="card service-detail">
        <Image src={photo2} alt="" loading="lazy" />
        <span class="number">03</span>
        <h3>Đánh nguyên cont</h3>
        <p>Hỗ trợ tổng kho lớn, gom/đánh cont trực tiếp từ xưởng về Việt Nam, giảm chi phí logistics.</p>
        <a class="text-link" href="contact.html" data-en="Get advice ↗">Nhận tư vấn ↗</a>
      </article>
      <article class="card service-detail">
        <Image src={photo3} alt="" loading="lazy" />
        <span class="number">04</span>
        <h3>Kho bãi chính chủ</h3>
        <p>Kho Bằng Tường, Quảng Châu chính chủ, không trung gian; xử lý nhanh, an toàn.</p>
        <a class="text-link" href="contact.html" data-en="Get advice ↗">Nhận tư vấn ↗</a>
      </article>
      <article class="card service-detail">
        <Image src={photo4} alt="" loading="lazy" />
        <span class="number">05</span>
        <h3>Kiểm hàng &amp; đóng gói</h3>
        <p>Kiểm hàng tại kho Trung Quốc, đóng gói tối ưu, hạn chế hư hỏng và chi phí vận chuyển.</p>
        <a class="text-link" href="contact.html" data-en="Get advice ↗">Nhận tư vấn ↗</a>
      </article>
      <article class="card service-detail">
        <Image src={photo5} alt="" loading="lazy" />
        <span class="number">06</span>
        <h3>Tư vấn cước &amp; lộ trình</h3>
        <p>Gợi ý phương án tối ưu thời gian, chi phí cho từng loại hàng, hỗ trợ 24/7.</p>
        <a class="text-link" href="contact.html" data-en="Get advice ↗">Nhận tư vấn ↗</a>
      </article>
    </div>
  </section>
  <section class="wrap section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Cảm nhận</p>
        <h2>Khách hàng nói gì?</h2>
      </div>
    </div>
    <div class="grid two">
      <figure class="card customer-quote">
        <Image src={photo6} alt="Khách hàng HL Trung Việt" loading="lazy" />
        <blockquote>
          <p>HL Trung Việt Logistics là đối tác vận chuyển tin cậy cho các lô hàng thương mại điện tử của chúng tôi.</p>
        </blockquote>
        <figcaption>
          <strong>Khách hàng</strong> · Ecommerce</figcaption>
        </figure>
        <figure class="card customer-quote">
          <Image src={photo7} alt="Khách hàng HL Trung Việt" loading="lazy" />
          <blockquote>
            <p>Hàng hóa luôn được giao đúng hẹn, đóng gói cẩn thận và được cập nhật trạng thái liên tục.</p>
          </blockquote>
          <figcaption>
            <strong>Khách hàng</strong> · Doanh nghiệp</figcaption>
          </figure>
          <figure class="card customer-quote">
            <Image src={photo8} alt="Khách hàng HL Trung Việt" loading="lazy" />
            <blockquote>
              <p>Kiểm hàng, đóng gói tốt, chi phí hợp lý giúp chúng tôi yên tâm nhập hàng.</p>
            </blockquote>
            <figcaption>
              <strong>Khách hàng</strong> · Bán lẻ</figcaption>
            </figure>
            <figure class="card customer-quote">
              <Image src={photo9} alt="Khách hàng HL Trung Việt" loading="lazy" />
              <blockquote>
                <p>Tư vấn cước tận tâm, hỗ trợ thông quan các ca khó rất hiệu quả.</p>
              </blockquote>
              <figcaption>
                <strong>Khách hàng</strong> · Nhập khẩu</figcaption>
              </figure>
            </div>
          </section>
        </Layout>
