---
import { Image } from "astro:assets";
import photo0 from "../assets/legacy/img/testimonial-1.jpg";
import photo1 from "../assets/legacy/img/testimonial-2.jpg";
import photo2 from "../assets/legacy/img/testimonial-3.jpg";
import photo3 from "../assets/legacy/img/testimonial-4.jpg";
import Layout from "../layouts/V2Layout.astro";
---
<Layout title="Cảm nhận · HL Trung Việt Logistics">
  <section class="tint">
    <div class="wrap section page-intro">
      <p class="eyebrow">HL TRUNG VIỆT LOGISTICS / TESTIMONIALS</p>
      <h1 data-en="Testimonials">Cảm nhận</h1>
      <a class="text-link" href="index.html" data-en="Home ↗">Trang chủ ↗</a>
    </div>
  </section>
  <section class="wrap section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Cảm nhận</p>
        <h2>Khách hàng nói gì?</h2>
      </div>
    </div>
    <div class="grid two">
      <figure class="card customer-quote">
        <Image src={photo0} alt="Khách hàng HL Trung Việt" loading="lazy" />
        <blockquote>
          <p>HL Trung Việt Logistics là đối tác vận chuyển tin cậy cho các lô hàng thương mại điện tử của chúng tôi.</p>
        </blockquote>
        <figcaption>
          <strong>Khách hàng</strong> · Ecommerce</figcaption>
        </figure>
        <figure class="card customer-quote">
          <Image src={photo1} alt="Khách hàng HL Trung Việt" loading="lazy" />
          <blockquote>
            <p>Hàng hóa luôn được giao đúng hẹn, đóng gói cẩn thận và được cập nhật trạng thái liên tục.</p>
          </blockquote>
          <figcaption>
            <strong>Khách hàng</strong> · Doanh nghiệp</figcaption>
          </figure>
          <figure class="card customer-quote">
            <Image src={photo2} alt="Khách hàng HL Trung Việt" loading="lazy" />
            <blockquote>
              <p>Kiểm hàng, đóng gói tốt, chi phí hợp lý giúp chúng tôi yên tâm nhập hàng.</p>
            </blockquote>
            <figcaption>
              <strong>Khách hàng</strong> · Bán lẻ</figcaption>
            </figure>
            <figure class="card customer-quote">
              <Image src={photo3} alt="Khách hàng HL Trung Việt" loading="lazy" />
              <blockquote>
                <p>Tư vấn cước tận tâm, hỗ trợ thông quan các ca khó rất hiệu quả.</p>
              </blockquote>
              <figcaption>
                <strong>Khách hàng</strong> · Nhập khẩu</figcaption>
              </figure>
            </div>
          </section>
        </Layout>
