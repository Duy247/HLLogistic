---
import { Image } from "astro:assets";
import photo0 from "../assets/v2/quote.webp";
import Layout from "../layouts/V2Layout.astro";
---
<Layout title="Liên hệ &amp; báo giá · HL Trung Việt Logistics">
<section class="wrap section contact-intro"><p class="eyebrow">LIÊN HỆ / BÁO GIÁ</p><h1 data-en="Let’s move your&lt;br&gt;business forward.">Gửi yêu cầu tới<br/>HL Trung Việt.</h1><p class="lead">Vui lòng để lại thông tin, chúng tôi sẽ liên hệ tư vấn nhanh nhất.</p><a class="text-link" href="tel:0966862355">Hotline: 0966 862 355 ↗</a></section><section class="quote-split" id="quote-section"><div class="quote-photo"><Image alt="Nhân viên HL Trung Việt xử lý kiện hàng tại xe" height="960" width="768" src={photo0} loading="lazy"/><span data-en="Care in every shipment.">Tận tâm trong từng kiện hàng.</span></div><div class="quote-panel"><p class="eyebrow">LET’S MOVE FORWARD</p><h2 data-en="Your next shipment starts here.">Lô hàng tiếp theo,<br/>bắt đầu từ đây.</h2><p data-en="Leave your details. Our team will help you plan your shipment.">Vui lòng để lại thông tin, chúng tôi sẽ liên hệ tư vấn nhanh nhất.</p><form data-quote class="quote-form" id="quote" novalidate=""><p>Các trường có dấu * là bắt buộc.</p><div class="grid two"><div class="field"><label for="name">Họ và tên *</label><input aria-describedby="name-help name-error" autocomplete="name" id="name" maxlength="100" name="name" required="" type="text"/><small id="name-help"></small><span class="error" id="name-error"></span></div><div class="field"><label for="phone">Số điện thoại *</label><input aria-describedby="phone-help phone-error" autocomplete="tel" id="phone" name="phone" pattern="[+0-9 ()-]{9,20}" required="" type="tel"/><small id="phone-help">Từ 9–20 ký tự: số, +, khoảng trắng, (), -.</small><span class="error" id="phone-error"></span></div><div class="field"><label for="email">Email</label><input aria-describedby="email-help email-error" autocomplete="email" id="email" name="email" type="email"/><small id="email-help"></small><span class="error" id="email-error"></span></div><div class="field"><label for="service">Dịch vụ *</label><select aria-describedby="service-error" id="service" required=""><option value="">Chọn dịch vụ</option><option value="1">Vận chuyển hàng hóa</option><option value="2">Mua hàng hộ</option><option value="3">Thanh toán hộ</option><option value="4">Tư vấn nhập hàng</option></select><span class="error" id="service-error"></span></div></div><div class="field"><label for="message">Tin nhắn *</label><textarea aria-describedby="message-help message-error" id="message" maxlength="2000" minlength="10" required="" rows="5"></textarea><small id="message-help">Ít nhất 10 ký tự. Cho biết loại hàng, trọng lượng hoặc thể tích và nơi nhận.</small><span class="error" id="message-error"></span></div><div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div><button>Gửi yêu cầu báo giá</button><div aria-live="polite" id="quote-status" role="status"></div></form></div></section><section class="contact-band"><div class="wrap band-grid"><div><p class="eyebrow">HERE TO HELP</p><h2 data-en="Connected. Every step of the way.">Luôn kết nối.<br/>Trên mọi hành trình.</h2><p data-en="Talk to us about your next shipment.">Tư vấn cước tối ưu cho từng lô hàng.</p><a class="band-phone" href="tel:0966862355">↗ 0966 862 355</a><div class="office-cards"><article><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" viewBox="0 0 24 24"><path d="m2 9 10-6 10 6v12H2V9Zm5 12V11h10v10M7 15h10M7 18h10"></path></svg><h3>Văn phòng Hà Nội</h3><p>D10-12 KĐT Geleximco, Lê Trọng Tấn, Hà Đông, Hà Nội</p></article><article><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" viewBox="0 0 24 24"><path d="M4 7 12 3l8 4v10l-8 4-8-4V7Zm0 0 8 4 8-4M12 11v10M8 5l8 4"></path></svg><h3>Kho Trung Quốc</h3><p>Bằng Tường · Quảng Châu</p><a href="contact.html">Liên hệ nhận hàng ↗</a></article></div></div><div><svg aria-labelledby="map-title" class="asia-map" role="img" viewBox="0 0 600 330"><title id="map-title">Sơ đồ kết nối Trung Quốc – Việt Nam, vị trí minh họa</title><defs><pattern height="7" id="dots" patternUnits="userSpaceOnUse" width="7"><circle cx="2" cy="2" fill="#61705f" r="1.4"></circle></pattern></defs><path d="M54 88 99 60 170 65 194 36 256 32 276 51 342 37 387 62 460 54 531 87 551 118 509 138 487 171 441 167 428 192 393 186 381 213 351 203 343 238 324 247 314 223 300 205 288 201 278 177 259 166 251 193 222 210 207 188 193 161 159 159 137 133 107 143 91 119 54 118ZM352 255 386 268 410 276 430 271 455 288 441 297 399 289 374 278ZM472 192 481 211 476 236 467 228ZM521 147 528 163 518 187 508 191 513 172ZM280 219 288 244 300 253 297 268 284 252 277 237Z" fill="url(#dots)"></path><path d="M372 143 Q340 170 349 199 T365 231" fill="none" stroke="#75C043" stroke-dasharray="4 5" stroke-width="1.5"></path><g fill="#75C043" stroke="#18351A" stroke-width="4"><circle cx="372" cy="143" r="7"></circle><circle cx="349" cy="199" r="7"></circle><circle cx="365" cy="231" r="7"></circle></g><g fill="white" font-family="Arial" font-size="12"><text x="387" y="139">TRUNG QUỐC</text><text x="265" y="202">HÀ NỘI</text><text x="379" y="237">VIỆT NAM</text></g></svg><p class="map-note" data-en="China – Vietnam network · Schematic locations">Kết nối Trung – Việt · Vị trí trên sơ đồ mang tính minh họa</p></div></div></section>
</Layout>
