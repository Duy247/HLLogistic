---
import { Image } from "astro:assets";
import photo0 from "../assets/legacy/img/team-1.jpg";
import photo1 from "../assets/legacy/img/team-2.jpg";
import photo2 from "../assets/legacy/img/team-3.jpg";
import photo3 from "../assets/legacy/img/team-4.jpg";
import photo4 from "../assets/legacy/img/team-2.jpg";
import photo5 from "../assets/legacy/img/team-3.jpg";
import photo6 from "../assets/legacy/img/team-4.jpg";
