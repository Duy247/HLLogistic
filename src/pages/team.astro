        <h3>Thành viên</h3>
        <p>Chức danh</p>
      </article>
      <article class="card person-card">
        <Image src={photo4} alt="Đội ngũ HL Trung Việt" loading="lazy" />
        <h3>Thành viên</h3>
        <p>Chức danh</p>
      </article>
      <article class="card person-card">
        <Image src={photo5} alt="Đội ngũ HL Trung Việt" loading="lazy" />
        <h3>Thành viên</h3>
        <p>Chức danh</p>
      </article>
      <article class="card person-card">
        <Image src={photo6} alt="Đội ngũ HL Trung Việt" loading="lazy" />
        <h3>Thành viên</h3>
