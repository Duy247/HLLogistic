import Layout from "../layouts/V2Layout.astro";
---
<Layout title="Đội ngũ · HL Trung Việt Logistics">
  <section class="tint">
    <div class="wrap section page-intro">
      <p class="eyebrow">HL TRUNG VIỆT LOGISTICS / OUR TEAM</p>
      <h1 data-en="Our team">Đội ngũ</h1>
      <a class="text-link" href="index.html" data-en="Home ↗">Trang chủ ↗</a>
    </div>
  </section>
  <section class="wrap section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Đội ngũ</p>
        <h2>Đội ngũ HL Trung Việt</h2>
      </div>
    </div>
    <div class="people-grid">
      <article class="card person-card">
        <Image src={photo0} alt="Đội ngũ HL Trung Việt" loading="lazy" />
        <h3>Thành viên</h3>
        <p>Chức danh</p>
      </article>
      <article class="card person-card">
        <Image src={photo1} alt="Đội ngũ HL Trung Việt" loading="lazy" />
