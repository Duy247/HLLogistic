      </article>
      <article class="card person-card">
        <Image src={photo7} alt="Đội ngũ HL Trung Việt" loading="lazy" />
        <h3>Thành viên</h3>
        <p>Chức danh</p>
      </article>
    </div>
  </section>
</Layout>
