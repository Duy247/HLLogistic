---
import Layout from "../layouts/V2Layout.astro";
---
<Layout title="Không tìm thấy trang · HL Trung Việt Logistics">
  <section class="tint">
    <div class="wrap section page-intro">
      <p class="eyebrow">HL TRUNG VIỆT LOGISTICS / PAGE NOT FOUND</p>
      <h1 data-en="Page Not Found">Không tìm thấy trang</h1>
      <a class="text-link" href="/" data-en="Home ↗">Trang chủ ↗</a>
    </div>
  </section>
  <section class="wrap section missing-page">
    <p class="eyebrow">404</p>
    <p data-en="We’re sorry, the page you have looked for does not exist in our website! Maybe go to our home page or try to use a search?">Trang bạn tìm kiếm không tồn tại trên website. Vui lòng trở về trang chủ hoặc liên hệ để được hỗ trợ.</p>
    <a class="button" href="/" data-en="Go Back To Home">Về trang chủ ↗</a>
  </section>
</Layout>
