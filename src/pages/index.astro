---
import ContactMap from "../components/ContactMap.astro";
import { Image } from "astro:assets";
import photo0 from "../assets/v2/hero.webp";
import photo1 from "../assets/v2/about-main.webp";
import photo2 from "../assets/v2/about-side.webp";
import photo3 from "../assets/v2/service-road.webp";
import photo4 from "../assets/v2/service-sea.webp";
import photo5 from "../assets/v2/service-air.webp";
import photo6 from "../assets/v2/service-warehouse.webp";
import photo7 from "../assets/v2/quote.webp";
import Layout from "../layouts/V2Layout.astro";
---
<Layout title="Trang chủ · HL Trung Việt Logistics" bodyClass="home">
<section class="photo-hero"><Image alt="Hàng hóa đóng kiện trên xe tại kho" height="700" width="1600" src={photo0} class="hero-image" fetchpriority="high"/><div class="wrap hero-content"><p class="eyebrow">CHINA → VIETNAM / HL LOGISTICS</p><h1 data-en="Across borders.&lt;br&gt;Closer to you.">Kết nối biên giới.<br/>Đưa hàng đến gần bạn.</h1><div class="hero-intro"><a class="button lime-button" data-en="Request a quote ↗" href="contact.html">Nhận báo giá ↗</a><p data-en="Road, sea and air freight from China to Vietnam. Optimizing cost and speed.">Đường bộ, đường biển, đường hàng không từ Trung Quốc về Việt Nam, tối ưu chi phí và tốc độ.</p></div><form action="track.html" class="hero-tracking"><div><label data-en="Where is your shipment?" for="number">Hàng của bạn đang ở đâu?</label><p data-en="Track your shipment · Sample code: SYZZ036501740">TRA CỨU VẬN ĐƠN · Mã ví dụ: SYZZ036501740</p></div><div class="hero-input"><input aria-label="Mã vận đơn / Tracking number" id="number" maxlength="80" name="number" placeholder="VD: SYZZ036501740" required=""/><button data-en="Track shipment →">Tra cứu vận đơn →</button></div></form></div></section><section aria-label="Số liệu" class="wrap stats"><article><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" viewBox="0 0 24 24"><path d="M8 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-6 10v-3a6 6 0 0 1 12 0v3M16 4a4 4 0 0 1 0 8m1 3a5 5 0 0 1 5 5"></path></svg><strong>6.826</strong><span data-en="Satisfied customers">Khách hàng hài lòng</span></article><article><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" viewBox="0 0 24 24"><path d="M4 7 12 3l8 4v10l-8 4-8-4V7Zm0 0 8 4 8-4M12 11v10M8 5l8 4"></path></svg><strong>38.639</strong><span data-en="Completed shipments">Lô hàng hoàn thành</span></article><article><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" viewBox="0 0 24 24"><path d="m12 3 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3L2.9 9.6l6.3-.9L12 3Z"></path></svg><strong>59.286</strong><span data-en="Positive reviews">Đánh giá tích cực</span></article></section><section class="wrap section about" id="about"><div class="section-label"><p class="eyebrow">VỀ CHÚNG TÔI / ABOUT</p><span>01 —</span></div><div class="about-main"><h2 data-en="Driven by a passion&lt;br&gt;for logistics.">Đồng hành cùng bạn,<br/>trên mỗi hành trình.</h2><span class="real-photo-frame"><Image alt="Nhân viên HL Trung Việt xếp hàng lên xe" height="960" width="768" src={photo1} class="about-tall" loading="lazy"/></span><p class="photo-caption">TRUNG QUỐC — VIỆT NAM</p></div><div class="about-side"><span class="real-photo-frame"><Image alt="Biển hiệu HL Trung Việt Logistics tại kho" height="600" width="800" src={photo2} loading="lazy"/></span><p class="eyebrow">HL TRUNG VIỆT LOGISTICS</p><h3 data-en="Solutions for every shipment">Giải pháp cho từng lô hàng</h3><p>Kho Bằng Tường, Quảng Châu chính chủ, không trung gian; xử lý nhanh, an toàn.</p><p>Gợi ý phương án tối ưu thời gian, chi phí cho từng loại hàng, hỗ trợ 24/7.</p><a class="text-link" data-en="Meet your logistics partner ↗" href="contact.html">Kết nối cùng chúng tôi ↗</a><div class="route"><span>Trung Quốc</span><span aria-hidden="true">──── →</span><span>Việt Nam</span></div></div></section><section class="services-section" id="services"><div class="wrap section"><div class="section-heading"><p class="eyebrow">DỊCH VỤ / SERVICES</p><h2 data-en="The right move.&lt;br&gt;For every shipment.">Phương án phù hợp.<br/>Cho từng lô hàng.</h2></div><div class="service-grid"><a class="photo-service" href="contact.html"><Image alt="" height="300" width="400" src={photo3} loading="lazy"/><div class="service-top"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" viewBox="0 0 24 24"><path d="M3 5h12v12H3zM15 10h4l3 4v3h-7M8 17a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm12 0a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z"></path></svg><span>01 /</span></div><div class="service-bottom"><h3>Đường bộ</h3><span class="service-en" lang="en">Road freight</span><p>Vận chuyển hàng hóa từ Trung Quốc về Việt Nam, tối ưu chi phí và tốc độ.</p><span aria-hidden="true" class="service-arrow">↗</span></div></a><a class="photo-service" href="contact.html"><Image alt="" height="300" width="400" src={photo4} loading="lazy"/><div class="service-top"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" viewBox="0 0 24 24"><path d="M5 13V7h14v6M9 7V3h6v4M2 14l10-4 10 4-4 6H6l-4-6Zm0 8q3-3 6 0 4-3 8 0 3-3 6 0"></path></svg><span>02 /</span></div><div class="service-bottom"><h3>Đường biển</h3><span class="service-en" lang="en">Sea freight</span><p>Hỗ trợ tổng kho lớn, gom/đánh cont trực tiếp từ xưởng về Việt Nam.</p><span aria-hidden="true" class="service-arrow">↗</span></div></a><a class="photo-service" href="contact.html"><Image alt="" height="300" width="400" src={photo5} loading="lazy"/><div class="service-top"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" viewBox="0 0 24 24"><path d="m3 11 7-1 5-7 3 1-3 6 6 2v2l-7 1-3 6H8l1-6-6-1z"></path></svg><span>03 /</span></div><div class="service-bottom"><h3>Đường hàng không</h3><span class="service-en" lang="en">Air freight</span><p>Tư vấn cước &amp; lộ trình, gợi ý phương án tối ưu thời gian cho từng loại hàng.</p><span aria-hidden="true" class="service-arrow">↗</span></div></a><a class="photo-service" href="contact.html"><Image alt="" height="300" width="400" src={photo6} loading="lazy"/><div class="service-top"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" viewBox="0 0 24 24"><path d="m2 9 10-6 10 6v12H2V9Zm5 12V11h10v10M7 15h10M7 18h10"></path></svg><span>04 /</span></div><div class="service-bottom"><h3>Kho bãi</h3><span class="service-en" lang="en">Warehousing</span><p>Kho Bằng Tường, Quảng Châu chính chủ, xử lý nhanh, an toàn.</p><span aria-hidden="true" class="service-arrow">↗</span></div></a></div><div class="service-extra"><p>Thông quan 2 đầu · Đánh nguyên cont · Kiểm hàng &amp; đóng gói</p><a class="button" data-en="Explore our services ↗" href="contact.html">Tư vấn dịch vụ ↗</a></div><details><summary>Tất cả giải pháp vận chuyển</summary><div class="grid three"><article class="service"><span class="number">01</span><h3>Vận chuyển hàng hóa</h3><p>Đường bộ, đường biển, đường hàng không từ Trung Quốc về Việt Nam, tối ưu chi phí và tốc độ.</p><a href="contact.html">Nhận tư vấn →</a></article><article class="service"><span class="number">02</span><h3>Thông quan 2 đầu</h3><p>Trực tiếp báo quan, xử lý kiểm hóa, đảm bảo thông quan trơn tru giữa Trung – Việt.</p><a href="contact.html">Nhận tư vấn →</a></article><article class="service"><span class="number">03</span><h3>Kho bãi chính chủ</h3><p>Kho Bằng Tường, Quảng Châu chính chủ, không trung gian; xử lý nhanh, an toàn.</p><a href="contact.html">Nhận tư vấn →</a></article><article class="service"><span class="number">04</span><h3>Đánh nguyên cont</h3><p>Hỗ trợ tổng kho lớn, gom/đánh cont trực tiếp từ xưởng về Việt Nam, giảm chi phí logistics.</p><a href="contact.html">Nhận tư vấn →</a></article><article class="service"><span class="number">05</span><h3>Kiểm hàng &amp; đóng gói</h3><p>Kiểm hàng tại kho Trung Quốc, đóng gói tối ưu, hạn chế hư hỏng và chi phí vận chuyển.</p><a href="contact.html">Nhận tư vấn →</a></article><article class="service"><span class="number">06</span><h3>Tư vấn cước &amp; lộ trình</h3><p>Gợi ý phương án tối ưu thời gian, chi phí cho từng loại hàng, hỗ trợ 24/7.</p><a href="contact.html">Nhận tư vấn →</a></article></div></details></div></section><section class="quote-split" id="quote-section"><div class="quote-photo"><Image alt="Nhân viên HL Trung Việt xử lý kiện hàng tại xe" height="960" width="768" src={photo7} loading="lazy"/><span data-en="Care in every shipment.">Tận tâm trong từng kiện hàng.</span></div><div class="quote-panel"><p class="eyebrow">LET’S MOVE FORWARD</p><h2 data-en="Your next shipment starts here.">Lô hàng tiếp theo,<br/>bắt đầu từ đây.</h2><p data-en="Leave your details. Our team will help you plan your shipment.">Vui lòng để lại thông tin, chúng tôi sẽ liên hệ tư vấn nhanh nhất.</p><form data-quote class="quote-form" id="quote" novalidate=""><p>Các trường có dấu * là bắt buộc.</p><div class="grid two"><div class="field"><label for="name">Họ và tên *</label><input aria-describedby="name-help name-error" autocomplete="name" id="name" maxlength="100" name="name" required="" type="text"/><small id="name-help"></small><span class="error" id="name-error"></span></div><div class="field"><label for="phone">Số điện thoại *</label><input aria-describedby="phone-help phone-error" autocomplete="tel" id="phone" name="phone" pattern="[+0-9 ()-]{9,20}" required="" type="tel"/><small id="phone-help">Từ 9–20 ký tự: số, +, khoảng trắng, (), -.</small><span class="error" id="phone-error"></span></div><div class="field"><label for="email">Email</label><input aria-describedby="email-help email-error" autocomplete="email" id="email" name="email" type="email"/><small id="email-help"></small><span class="error" id="email-error"></span></div><div class="field"><label for="service">Dịch vụ *</label><select aria-describedby="service-error" id="service" required=""><option value="">Chọn dịch vụ</option><option value="1">Vận chuyển hàng hóa</option><option value="2">Mua hàng hộ</option><option value="3">Thanh toán hộ</option><option value="4">Tư vấn nhập hàng</option></select><span class="error" id="service-error"></span></div></div><div class="field"><label for="message">Tin nhắn *</label><textarea aria-describedby="message-help message-error" id="message" maxlength="2000" minlength="10" required="" rows="5"></textarea><small id="message-help">Ít nhất 10 ký tự. Cho biết loại hàng, trọng lượng hoặc thể tích và nơi nhận.</small><span class="error" id="message-error"></span></div><div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div><button>Gửi yêu cầu báo giá</button><div aria-live="polite" id="quote-status" role="status"></div></form></div></section><section class="tint" id="rates"><div class="wrap section"><p class="eyebrow">BẢNG GIÁ</p><h2>Cước vận chuyển, rõ đơn vị</h2><p>Bảng giá mang tính tham khảo, vui lòng liên hệ hotline để nhận báo giá tối ưu cho từng lô hàng.</p><div class="grid three"><article class="card"><span>Hàng rời, hàng lẻ · Line TMĐT</span><h3 class="price">26.000 <small>VNĐ/kg</small></h3><p>Dưới 100 kg · 3 – 4 ngày</p></article><article class="card"><span>Bằng Tường → Hà Nội</span><h3 class="price">1.600.000 <small>VNĐ/m³</small></h3><p>Hàng phổ thông ≤ 250 kg/m³, dưới 10 m³</p></article><article class="card"><span>Bằng Tường → Hồ Chí Minh</span><h3 class="price">2.150.000 <small>VNĐ/m³</small></h3><p>Hàng phổ thông ≤ 250 kg/m³</p></article></div><details><summary>Xem cước line nhanh và lưu ý</summary><div class="table-wrap"><table><caption>Hàng rời, hàng lẻ — đơn vị VNĐ/kg</caption><thead><tr><th scope="col">Trọng lượng</th><th scope="col">Line TMĐT</th><th scope="col">Line nhanh</th></tr></thead><tbody><tr><th scope="row">Dưới 10 kg</th><td>26.000</td><td>32.000</td></tr><tr><th scope="row">10 đến dưới 50 kg</th><td>26.000</td><td>30.000</td></tr><tr><th scope="row">50 đến dưới 100 kg</th><td>26.000</td><td>25.000</td></tr></tbody></table></div><p>Line nhanh: 1 – 2 ngày. Hà Nội: hàng phổ thông ≥ 10 m³ có giá 1.550.000 VNĐ/m³. Nhận hàng tại Quảng Châu: +2.000 VNĐ/kg và +400.000 VNĐ/m³. Tuyến Hồ Chí Minh: chỉ nhận đơn ≥100 kg hoặc ≥0,5 m³; dưới mức này phụ thu 2.000 VNĐ/kg và 200.000 VNĐ/m³.</p><p>Giá trên chưa thể hiện tổng chi phí mua hàng, phí dịch vụ mua hộ, kiểm đếm, đóng gỗ và giao nội địa. Liên hệ để xác nhận loại hàng, điều kiện nhận hàng và báo giá chi tiết.</p></details><a class="button" href="contact.html">Nhận báo giá cho lô hàng →</a></div></section><section class="contact-band"><div class="wrap band-grid"><div><p class="eyebrow">HERE TO HELP</p><h2 data-en="Connected. Every step of the way.">Luôn kết nối.<br/>Trên mọi hành trình.</h2><p data-en="Talk to us about your next shipment.">Tư vấn cước tối ưu cho từng lô hàng.</p><a class="band-phone" href="tel:0966862355">↗ 0966 862 355</a><div class="office-cards"><article><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" viewBox="0 0 24 24"><path d="m2 9 10-6 10 6v12H2V9Zm5 12V11h10v10M7 15h10M7 18h10"></path></svg><h3>Văn phòng Hà Nội</h3><p>D10-12 KĐT Geleximco, Lê Trọng Tấn, Hà Đông, Hà Nội</p></article><article><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" viewBox="0 0 24 24"><path d="M4 7 12 3l8 4v10l-8 4-8-4V7Zm0 0 8 4 8-4M12 11v10M8 5l8 4"></path></svg><h3>Kho Trung Quốc</h3><p>Bằng Tường · Quảng Châu</p><a href="contact.html">Liên hệ nhận hàng ↗</a></article></div></div><div><ContactMap /><p class="map-note" data-en="China – Vietnam network · Schematic locations">Kết nối Trung – Việt · Vị trí trên sơ đồ mang tính minh họa</p></div></div></section>
</Layout>
