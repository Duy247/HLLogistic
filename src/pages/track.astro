---
import { Image } from "astro:assets";
import photo0 from "../assets/v2/track-header.webp";
import Layout from "../layouts/V2Layout.astro";
---
<Layout title="Tra cứu vận đơn · HL Trung Việt Logistics">
<div class="track-photo real-photo-frame"><Image alt="Minh họa theo dõi giao hàng qua điện thoại" height="700" width="1600" src={photo0} fetchpriority="high"/></div><section class="wrap section"><p class="eyebrow">TRA CỨU VẬN ĐƠN</p><h1>Theo dõi hành trình hàng hóa</h1><p>Cập nhật nội bộ và hãng vận chuyển được hiển thị độc lập.</p><form class="card" id="tracking-form"><div class="grid two"><div class="field"><label for="tracking-number">Mã vận đơn</label><input aria-describedby="number-help number-error" id="tracking-number" maxlength="80" name="number" placeholder="SYZZ036501740" required="" type="text"/><small id="number-help"></small><span class="error" id="number-error"></span></div><div class="field"><label for="carrier-input">Hãng vận chuyển (tùy chọn)</label><input id="carrier-input" name="carrierText" list="carrier-list" autocomplete="off" /><datalist id="carrier-list"></datalist><small id="carrier-help">Lựa chọn hiện tại được dùng cho mỗi lần tra cứu.</small></div></div><button>Tra cứu vận đơn</button><p class="error" id="carrier-warning" role="status"></p></form><p id="tracking-status" role="status">Nhập mã vận đơn để bắt đầu.</p><div class="grid two"><section class="card"><h2>Cập nhật nội bộ</h2><div aria-live="polite" id="internal-updates" role="status">Chưa tra cứu.</div></section><section class="card"><h2>Hãng vận chuyển</h2><div aria-live="polite" id="tracking-pretty" role="status">Chưa tra cứu.</div></section></div><p>Cần hỗ trợ? <a href="contact.html">Liên hệ HL Trung Việt</a> hoặc <a href="tel:0966862355">0966 862 355</a>.</p></section><pre id="tracking-result" hidden></pre>
</Layout>
<script is:inline src="/js/tracking-v2.js"></script>
