---
import Layout from "../layouts/V2Layout.astro";
---
<Layout title="Tin tức · HL Trung Việt Logistics">
  <section class="tint">
    <div class="wrap section page-intro">
      <p class="eyebrow">HL TRUNG VIỆT LOGISTICS / NEWS</p>
      <h1 data-en="News">Tin tức</h1>
      <a class="text-link" href="/" data-en="Home ↗">Trang chủ ↗</a>
    </div>
  </section>
  <section class="wrap section news-board">
    <div>
      <article id="news-detail" class="card news-detail is-hidden">
        <button id="news-detail-back" class="secondary" type="button">← Quay lại danh sách</button>
        <h2 id="news-detail-title">...</h2>
        <div id="news-detail-meta" class="small">...</div>
        <div id="news-detail-content" class="news-detail__content">
        </div>
      </article>
      <div class="section-heading">
        <h2>Bài viết mới nhất</h2>
        <span id="news-count" class="small" aria-live="polite">Đang tải...</span>
      </div>
      <div id="news-list" class="news-list">
      </div>
      <div class="news-controls">
        <button id="news-load-more" type="button">Xem thêm</button>
        <div id="news-status" role="status" aria-live="polite">
        </div>
      </div>
    </div>
    <aside class="news-sidebar">
      <section class="card">
        <h2>Chủ đề nổi bật</h2>
        <ul>
          <li>Lịch thông quan tuần</li>
          <li>Đổi lịch kho Bằng Tường</li>
          <li>Update tuyến bay nhanh</li>
          <li>Mức cước tối ưu</li>
        </ul>
      </section>
      <section class="card">
        <h2>Nhận bản tin</h2>
        <p>Nhận bản tin mới nhất về lịch vận chuyển, ưu đãi và cập nhật kho.</p>
        <a class="text-link" href="mailto:vietson707@gmail.com">Đăng ký qua email ↗</a>
      </section>
      <section class="card">
        <h2>Đăng bài mới</h2>
        <p>Bộ phận vận hành có thể đẩy tin ngay khi phát sinh thay đổi lịch vận.</p>
      </section>
    </aside>
  </section>
  <script is:inline src="/js/news.js">
  </script>
</Layout>
