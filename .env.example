# Server-only values. Supply independent random secrets through deployment settings.
NEWS_ADMIN_SECRET=
PARCEL_UPDATES_SECRET=
TRACK17_KEY=
SITE_ORIGIN=https://www.hltrungviet.com
# Configure database variables through the Vercel Postgres integration.
POSTGRES_URL=
# At least 32 random characters; required for account sessions. Never expose to clients.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
# Temporary rollout only; defaults off. Enables NEWS_ADMIN_SECRET/PARCEL_UPDATES_SECRET.
LEGACY_ADMIN_SECRET_ENABLED=false
TRACK_RATE_WINDOW_SECONDS=60
TRACK_RATE_IP_LIMIT=10
TRACK_RATE_GLOBAL_LIMIT=200
