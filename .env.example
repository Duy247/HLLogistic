# Server-only values. Supply independent random secrets through deployment settings.
NEWS_ADMIN_SECRET=
PARCEL_UPDATES_SECRET=
TRACK17_KEY=
SITE_ORIGIN=https://www.hltrungviet.com
# Configure database variables through the Vercel Postgres integration.
POSTGRES_URL=
# Exactly 64 hex characters (32 bytes): generate with openssl rand -hex 32.
# Invalid/missing keys are rejected on use. Server-only; never expose to clients.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
# Temporary rollout only; defaults off. Enables NEWS_ADMIN_SECRET/PARCEL_UPDATES_SECRET.
LEGACY_ADMIN_SECRET_ENABLED=false
TRACK_RATE_WINDOW_SECONDS=60
TRACK_RATE_IP_LIMIT=10
TRACK_RATE_GLOBAL_LIMIT=200

# Independent login budgets; usernames are normalized and hashed before bucketing.
ADMIN_LOGIN_RATE_WINDOW_SECONDS=900
ADMIN_LOGIN_RATE_IP_LIMIT=5
ADMIN_LOGIN_RATE_GLOBAL_LIMIT=200
# Must exceed the IP limit; smaller values are raised to IP limit + 1.
ADMIN_LOGIN_RATE_USERNAME_LIMIT=10
